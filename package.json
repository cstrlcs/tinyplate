{
  "name": "@cstrlcs/interpolate",
  "version": "2.2.0",
  "private": false,
  "description": "A dead simple templating (<21 LOC) engine written in pure typescript.",
  "keywords": [
    "fast",
    "small",
    "template",
    "template engine",
    "templating"
  ],
  "homepage": "https://github.com/cstrlcs/interpolate#readme",
  "bugs": "https://github.com/cstrlcs/interpolate/issues",
  "license": "MIT",
  "author": "Lucas Castro <contact@lucascastro.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cstrlcs/interpolate.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "build:js": "bun build ./src/index.ts --outdir ./dist --minify",
    "build:ts": "cp index.d.ts dist/index.d.ts",
    "build:readme": "bun readme.ts",
    "build": "bun build:js && bun build:ts && bun build:readme",
    "release": "publi.sh",
    "check": "bun run lint && bun run format:check && tsc --noEmit && bun run test",
    "format:check": "oxfmt --check",
    "postinstall": "lefthook install",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix; s=$?; oxfmt; exit $s",
    "test": "bun test"
  },
  "devDependencies": {
    "@cstrlcs/configs": "9.5.2",
    "@types/bun": "1.4.2",
    "lefthook": "latest",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "latest"
  },
  "packageManager": "bun@1.4.0"
}
